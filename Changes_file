Phase 3 – Add automated testing
Create:
tests/test_exposure_comparison.py
Use a small controlled dataset first. This is better than relying entirely on your large production dataset.












import pandas as pd

from reporting.exposure_comparison import (
    create_quarterly_exposure_comparison
)


def sample_data():

    return pd.DataFrame({
        "Closing Date": [
            "2026-06-30",
            "2026-06-30",
            "2026-09-30",
            "2026-09-30"
        ],

        "Customer Nature": [
            "Loans to customers",
            "Loans to customers",
            "Loans to customers",
            "Loans to customers"
        ],

        "Product": [
            "Loans", "Loans", "Loans", "Loans"
        ],

        "RMPM ID (Principal restitution party)": [
            "123", "123", "123", "123"
        ],

        "Corporate name (Principal restitution party)": [
            "ABC Bank", "ABC Bank", "ABC Bank", "ABC Bank"
        ],

        "Balance Type": [
            "Gross value",
            "Impairment",
            "Gross value",
            "Impairment"
        ],

        "Amount in K EUR": [
            100, -5, 120, -10
        ],

        "Impairment type (final stage) - R": [
            "1", "1", "2", "2"
        ],

        "CTM (Owner) - R": [
            "CTM510", "CTM510", "CTM300", "CTM300"
        ]
    })


def test_stg_calculation():

    df = sample_data()

    result = create_quarterly_exposure_comparison(
        df,
        "Impairment type (final stage) - R"
    )

    assert len(result) == 1

    assert result.iloc[0]["Current Gross Value"] == 120
    assert result.iloc[0]["Current Impairment"] == -10
    assert result.iloc[0]["Current Carrying Amount"] == 110

    assert result.iloc[0]["Previous Gross Value"] == 100
    assert result.iloc[0]["Previous Impairment"] == -5
    assert result.iloc[0]["Previous Carrying Amount"] == 95

    assert result.iloc[0][
        "Current Impairment type (final stage) - R"
    ] == "2"


def test_ctm_calculation():

    df = sample_data()

    result = create_quarterly_exposure_comparison(
        df,
        "CTM (Owner) - R"
    )

    assert len(result) == 1

    assert result.iloc[0]["Current Carrying Amount"] == 110

    assert result.iloc[0]["Previous Carrying Amount"] == 95

    assert result.iloc[0]["Current CTM (Owner) - R"] == "CTM300"















