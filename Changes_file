Phase 2 – Create the reporting runner
Once the notebook tests pass, create:
reporting/report_runner.py
This file will execute both reports together.









from reporting.exposure_comparison import (
    create_quarterly_exposure_comparison
)


def run_exposure_reporting(df):

    # STG reporting
    stg_df = create_quarterly_exposure_comparison(
        df=df,
        classification_col=(
            "Impairment type (final stage) - R"
        )
    )

    # CTM reporting
    ctm_df = create_quarterly_exposure_comparison(
        df=df,
        classification_col="CTM (Owner) - R"
    )

    return {
        "stg_exposure": stg_df,
        "ctm_exposure": ctm_df,
        "status": "COMPLETED"
    }











